# Copy this file to .env and fill in your own key. Never commit .env.
ANTHROPIC_API_KEY=

# Jev (TypeSafe AI) - leave empty until you get API access
JEV_API_KEY=

# Claude settings (same for both modes so the comparison is fair)
CLAUDE_MODEL=claude-sonnet-5-5
CLAUDE_EFFORT=low
CLAUDE_MAX_TOKENS=4096

# SQLite database path
DB_PATH=data/railway.db
